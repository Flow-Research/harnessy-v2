{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"ignorePatterns": [
		"**/node_modules/**",
		"**/dist/**",
		"open-src/**",
		"harnessy-v1/**",
		"packages/capability-harnessy-v1-full/**"
	],
	"jsPlugins": ["oxlint-plugin-eslint"],
	"rules": {
		"eslint-js/no-restricted-syntax": "off"
	},
	"overrides": [
		{
			"files": ["packages/harnessy-local-host/src/portal/app/**/*.tsx", "packages/harnessy-local-host/src/portal/app/**/*.ts"],
			"plugins": ["react"],
			"rules": {
				"react/no-danger": "error",
				"react/no-danger-with-children": "error",
				"eslint-js/no-restricted-syntax": [
					"error",
					{
						"selector": "MemberExpression[property.name=/^(innerHTML|outerHTML)$/]",
						"message": "The app renders text through React only; never assign markup."
					},
					{
						"selector": "CallExpression[callee.property.name=/^(insertAdjacentHTML|write|writeln)$/]",
						"message": "The app renders text through React only; never write markup."
					}
				]
			}
		},
		{
			"files": ["packages/harnessy-core/src/**/*.ts"],
			"rules": {
				"eslint-js/no-restricted-syntax": [
					"error",
					{
						"selector": "TryStatement > CatchClause",
						"message": "Do not use try/catch — this is an Effect codebase. Wrap throwing code with Effect.try / Effect.tryPromise and map to a tagged HarnessError, or guard with non-throwing APIs (e.g. URL.canParse)."
					}
				]
			}
		},
		{
			"files": ["packages/harnessy-core/src/claude-bridge/**/*.ts"],
			"rules": {
				"eslint-js/no-restricted-syntax": "off"
			}
		}
	]
}
