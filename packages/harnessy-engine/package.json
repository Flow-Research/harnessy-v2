{
  "name": "@harnessy/engine",
  "version": "0.0.3",
  "description": "Bundled Harnessy engine host facade and Cloudflare Worker adapter",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js"
    }
  },
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "tsup && node scripts/audit-bundles.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:fixture": "node scripts/fixture-smoke.mjs",
    "prepublishOnly": "npm run clean && npm run build && npm run typecheck && npm run test && npm run test:fixture"
  },
  "dependencies": {
    "@cloudflare/workers-types": "4.20250620.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@standard-schema/spec": "1.1.0",
    "agents": "0.17.3",
    "effect": "4.0.0-beta.85"
  },
  "devDependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@effect/platform-node": "4.0.0-beta.85",
    "@effect/vitest": "4.0.0-beta.85",
    "@libsql/client": "0.17.3",
    "@paralleldrive/cuid2": "3.3.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.19.19",
    "drizzle-orm": "0.45.2",
    "fractional-indexing": "3.2.0",
    "js-yaml": "4.2.0",
    "kysely": "0.28.17",
    "oauth4webapi": "3.8.5",
    "openapi-types": "12.1.3",
    "semver": "7.8.0",
    "shx": "0.4.0",
    "tldts": "7.0.28",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "urlpattern-polyfill": "10.1.0",
    "vitest": "4.1.9",
    "wrangler": "4.110.0",
    "zod": "4.3.6"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
