{
  "id": "local:social-cockpit",
  "name": "Harnessy Social Cockpit",
  "version": "0.1.0",
  "description": "Read scoped social channels and prepare replies for human review.",
  "context": ["README.md"],
  "resources": [
    {
      "kind": "extension",
      "path": "agent.ts",
      "target": "extensions/social-cockpit.ts",
      "description": "Register the scoped inbox and draft tools."
    }
  ],
  "permissions": ["social:read", "social:triage", "social:draft"],
  "blastRadius": "medium",
  "egress": ["local Harnessy social API"],
  "dataCategories": ["private_messages", "public_posts", "drafts"]
}
