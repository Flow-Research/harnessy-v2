{
	"name": "@harnessy/core",
	"version": "0.0.3",
	"description": "Effect-powered Harnessy capability harness CLI and core runtime",
	"type": "module",
	"license": "AGPL-3.0-or-later",
	"bin": {
		"harnessy": "dist/cli.js",
		"hsy": "dist/hsy.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./connectors/anytype": {
			"types": "./dist/connectors/anytype.d.ts",
			"import": "./dist/connectors/anytype.js"
		},
		"./connectors/knowledge": {
			"types": "./dist/connectors/knowledge.d.ts",
			"import": "./dist/connectors/knowledge.js"
		},
		"./connectors/loopback": {
			"types": "./dist/connectors/loopback.d.ts",
			"import": "./dist/connectors/loopback.js"
		}
	},
	"files": [
		"dist",
		"fixtures",
		"resources",
		"THIRD_PARTY_LICENSES",
		"CLAUDE_BRIDGE_VENDOR.md",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "bun run --cwd ../../executor/apps/local build && tsgo -p tsconfig.build.json && shx chmod +x dist/cli.js dist/hsy.js",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.2.141",
		"@anthropic-ai/sdk": "0.73.0",
		"@earendil-works/pi-ai": "0.80.3",
		"@earendil-works/pi-coding-agent": "0.80.3",
		"@earendil-works/pi-tui": "0.80.3",
		"@effect/platform-node": "4.0.0-beta.85",
		"cc-session-io": "0.3.1",
		"change-case": "5.4.4",
		"cross-spawn": "7.0.6",
		"effect": "4.0.0-beta.85",
		"executor": "1.5.33",
		"shell-quote": "1.8.4",
		"typebox": "1.3.3",
		"yaml": "2.9.0",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@effect/vitest": "4.0.0-beta.85",
		"@types/cross-spawn": "6.0.6",
		"@types/shell-quote": "1.7.5",
		"shx": "0.4.0",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"keywords": [
		"agent",
		"capabilities",
		"cli",
		"effect",
		"harnessy"
	]
}
