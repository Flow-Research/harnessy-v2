+@pytest.mark.parametrize("projects_name", ["sibling-projects", "sibling projects"])
+def test_external_projects_root_preserves_v2_private_context(
+    tmp_path, monkeypatch, projects_name,
+) -> None:
+    project_root = tmp_path / "V2 private workspace"
+    projects_root = tmp_path / projects_name
+    private_root = project_root / ".jarvis" / "context" / "private" / "tester"
+    write(private_root / "priorities.md", "# Priorities\n\nCanonical private priorities.\n")
+    write(private_root / "facts.md", "# Facts\n\nCanonical private facts.\n")
+    today = datetime.date.today().isoformat()
+    write(
+        private_root / "meetings" / "private.md",
+        f"# Private Review\n\n- Date: {today}\n\n## Summary\n\nPrivate commitment.\n",
+    )
+    vault_root = projects_root / "sibling" / "dev" / ".jarvis" / "context"
+    write(vault_root / "status.md", "# Status\n\nSibling project state.\n")
+    write(
+        vault_root / "meetings" / "sibling.md",
+        f"# Sibling Review\n\n- Date: {today}\n\n## Summary\n\nSibling commitment.\n",
+    )
+    write(
+        project_root / "projects" / "not-selected" / ".jarvis" / "context" / "status.md",
+        "# Unselected default collection root\n",
+    )
+
+    collect_state = load_collect_state(project_root, monkeypatch, projects_root)
+
+    assert collect_state.PROJECTS_DIR == str(projects_root)
+    assert collect_state.PRIVATE_DIR == str(private_root)
+    assert "Canonical private priorities" in collect_state.collect_priorities()["raw"]
+    assert "Canonical private facts" in collect_state.collect_projects()["_private/facts.md"]["content"]
+    vaults = collect_state.collect_project_context_vaults()
+    assert set(vaults) == {"sibling"}
+    assert "Sibling project state" in vaults["sibling"]["status_md"]
+    assert vaults["sibling"]["recent_meetings"][0]["title"] == "Sibling Review"
+    meetings = collect_state.collect_recent_meetings()
+    assert {meeting["title"] for meeting in meetings} == {"Private Review", "Sibling Review"}
+    sibling = next(meeting for meeting in meetings if meeting["title"] == "Sibling Review")
+    assert (project_root / sibling["path"]).resolve() == vault_root / "meetings" / "sibling.md"
+
