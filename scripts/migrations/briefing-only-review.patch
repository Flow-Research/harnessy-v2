+def test_expired_ambiguous_send_is_not_automatically_replayed(setup):
+    clock, store, make, _ = setup
+    posts = []
+
+    def transport(request):
+        assert request.method == "POST"
+        posts.append(json.loads(request.content))
+        if len(posts) == 1:
+            raise Crash("Process interrupted after synthetic provider accepted POST")
+        return httpx.Response(200, json={"id": "second-receipt"})
+
+    service = make(transport)
+    with pytest.raises(Crash):
+        service.worker(max_items=1)
+    assert store.get("fixture").status.value == "publishing"
+    assert store.get("fixture").discord_message_id is None
+    clock[0] += timedelta(minutes=11)
+    service.worker(max_items=1)
+    assert len(posts) == 1, f"Ambiguous POST automatically replayed: {len(posts)}"
+
+
+def test_slow_owner_is_not_overlapped_after_expiry(setup):
+    clock, store, make, _ = setup
+    posts = []
+
+    def transport(request):
+        posts.append(json.loads(request.content))
+        if len(posts) == 1:
+            clock[0] += timedelta(minutes=11)
+            service.worker(max_items=1)
+            return httpx.Response(200, json={"id": "first-owner-receipt"})
+        return httpx.Response(200, json={"id": "second-owner-receipt"})
+
+    service = make(transport)
+    service.worker(max_items=1)
+    assert len(posts) == 1, (
+        f"Live owner overlapped: {len(posts)} POSTs; "
+        f"retained {store.get('fixture').discord_message_id}"
+    )
