+item=service.store.get(sys.argv[2]); stage=sys.argv[3]
+write=module._write_private
+def interrupt(path, content):
+    write(path,content)
+    if path.name == stage:
+        os._exit(71)
+module._write_private=interrupt
+connect=sqlite3.connect
+class Connection(sqlite3.Connection):
+    def commit(self):
