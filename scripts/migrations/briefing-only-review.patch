+def test_uncertainty_cannot_be_reapproved_or_rewritten(setup):
+    _, store, make, _ = setup
+
+    def transport(request):
+        raise httpx.ReadTimeout("uncertain", request=request)
+
+    service = make(transport)
+    service.worker(max_items=1)
+    item = store.get("fixture")
+    assert item.status.value == "publishing"
+    assert item.error_stage == "uncertain-discord"
+    markdown, summary = service.read_artifacts(item)
+    actions = [
+        lambda: service.approve("fixture", markdown=markdown, discord_summary=summary),
+        lambda: service.save_draft(
+            "fixture", markdown=markdown + "\nChanged.", discord_summary=summary
+        ),
+        lambda: service.reject("fixture"),
+        lambda: service.start_regeneration("fixture"),
+        lambda: service.start_revision(
+            "fixture", instruction="Clarify", markdown=markdown, discord_summary=summary
+        ),
+        lambda: service.generate(week_start=item.week_start, regenerate=True),
+    ]
+    for action in actions:
+        with pytest.raises(ValueError, match="publishing or published|only a pending briefing"):
+            action()
+        assert store.get("fixture") == item
+    assert item.google_doc_id == "synthetic-doc"
+    assert item.approved_hash
+
