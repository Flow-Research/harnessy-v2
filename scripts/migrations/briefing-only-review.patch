@@ -0,0 +1,100 @@
+"""Real temporary state/HTTP; only the host launchd boundary is simulated."""
+
+import json
+import os
+import shutil
+import socket
+import subprocess
+import threading
+from pathlib import Path
+
+import pytest
+from click.testing import CliRunner
+
+from jarvis.community_briefing.cli import community_cli
+from jarvis.community_briefing.service import CommunityBriefingService
+from jarvis.config import save_config
+from jarvis.config.schema import CommunityBriefingConfig, JarvisConfig
+from jarvis.meetings.publication.launchd import briefing_review_plist_path, review_plist_path
+from jarvis.meetings.publication.review import create_briefing_review_server
+
+
+@pytest.fixture
+def isolated_config(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> CommunityBriefingConfig:
+    """Drop ambient credentials and reject external sockets before network I/O."""
+
+    for key in tuple(os.environ):
+        monkeypatch.delenv(key)
+    monkeypatch.setenv("HOME", str(tmp_path))
+    monkeypatch.setenv("JARVIS_DISCORD_BOT_TOKEN", "synthetic-test-token")
+    connect = socket.socket.connect
+
+    def loopback_only(sock, address):
+        assert isinstance(address, tuple) and address[0] in ("127.0.0.1", "::1")
+        return connect(sock, address)
+
+    monkeypatch.setattr(socket.socket, "connect", loopback_only)
+    return CommunityBriefingConfig(
+        enabled=True,
+        source_path=str(tmp_path),
+        draft_path=str(tmp_path / "drafts"),
+        state_path=str(tmp_path / "state"),
+        discord_channel_id="123456789012345678",
+    )
+
+
+def test_status_requires_briefing_only_definition(isolated_config) -> None:
+    """An old meeting plist cannot satisfy the briefing installation check."""
+
+    save_config(JarvisConfig(community_briefing=isolated_config))
+    old = review_plist_path()
+    old.parent.mkdir(parents=True)
+    old.write_text("legacy meeting owner")
+    runner = CliRunner()
+    result = runner.invoke(community_cli, ["briefing", "status", "--json"])
+    assert result.exit_code == 0, result.exception
+    assert json.loads(result.output)["review_service_installed"] is False
+    separate = briefing_review_plist_path()
+    assert separate.name == "tech.flowresearch.jarvis.briefing-review.plist"
+    separate.write_text("separate briefing owner")
+    result = runner.invoke(community_cli, ["briefing", "status", "--json"])
+    assert result.exit_code == 0, result.exception
+    assert json.loads(result.output)["review_service_installed"] is True
+    assert old.read_text() == "legacy meeting owner"
+
+
+@pytest.mark.parametrize("loaded_owner", ["meeting-review", "briefing-review"])
+def test_preflight_requires_separate_loaded_owner(isolated_config, monkeypatch, loaded_owner):
+    """Even a healthy loopback endpoint cannot compensate for the wrong owner."""
+
+    observed = []
+    which = shutil.which
+    monkeypatch.setattr(
+        shutil, "which", lambda name: "/synthetic/launchctl" if name == "launchctl" else which(name)
+    )
+
+    def launchctl_only(command, **kwargs):
+        assert command[:2] == ["launchctl", "print"]
+        observed.append(command[2])
+        return subprocess.CompletedProcess(command, 0 if command[2].endswith(loaded_owner) else 1)
+
+    # Simulate OS ownership, not application services, DB operations or HTTP responses.
+    monkeypatch.setattr(subprocess, "run", launchctl_only)
+    service = CommunityBriefingService(isolated_config.model_copy(update={"review_port": 0}))
+    server = create_briefing_review_server(service)
+    service.config = service.config.model_copy(update={"review_port": server.server_port})
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    try:
+        result = service.preflight(check_providers=False)
+        check = next(check for check in result.checks if check.name == "review_service")
+        assert check.passed is (loaded_owner == "briefing-review")
+        assert check.required
+        assert f"gui/{os.getuid()}/tech.flowresearch.jarvis.briefing-review" in observed
+        assert not any(value.endswith(".meeting-review") for value in observed)
+        assert service._google is None and service._discord is None
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join(timeout=2)
+        service.close()
