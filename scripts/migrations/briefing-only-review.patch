@@ -0,0 +1,102 @@
+"""Migration separation through real loopback HTTP and temporary SQLite state."""
+
+import re
+import shlex
+import threading
+from datetime import date
+from pathlib import Path
+from unittest.mock import Mock
+
+import httpx
+
+from jarvis.community_briefing.service import CommunityBriefingService
+from jarvis.meetings.publication.models import PublicationStatus
+from jarvis.meetings.publication.notify import LocalNotifier, review_token
+from jarvis.meetings.publication.review import create_briefing_review_server
+
+from .test_service_review import (
+    FakeAI,
+    FakeDiscord,
+    FakeGoogle,
+    FakeNotifier,
+    _config,
+    _write_source,
+)
+
+
+def test_briefing_only_review_never_opens_meeting_queue(tmp_path, monkeypatch):
+    source = tmp_path / "private"
+    _write_source(source)
+    google, discord = FakeGoogle(), FakeDiscord()
+    service = CommunityBriefingService(
+        _config(tmp_path, source).model_copy(update={"review_port": 0}),
+        ai=FakeAI(),
+        google=google,
+        discord=discord,
+        notifier=FakeNotifier(),
+    )
+    generated = service.generate(week_start=date(2026, 8, 24))
+    assert generated.item is not None
+    # A broken sentinel would fail if any meeting store tried to open it.
+    meeting_queue = Path(service.state_root) / "queue.sqlite3"
+    meeting_queue.write_bytes(b"not a meeting database; must remain untouched")
+    before = meeting_queue.read_bytes()
+    monkeypatch.setattr(
+        "jarvis.meetings.publication.review.PublicationService",
+        Mock(side_effect=AssertionError("meeting service forbidden")),
+    )
+    server = create_briefing_review_server(service)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    try:
+        with httpx.Client(
+            base_url=f"http://127.0.0.1:{server.server_port}", trust_env=False
+        ) as client:
+            assert client.get("/").status_code == 401
+            inbox = client.get("/", params={"token": review_token(service.state_root)})
+            assert inbox.status_code == 200
+            assert "Weekly briefing review" in inbox.text
+            assert "Review meeting" not in inbox.text
+            page = client.get(f"/briefing/{generated.item.briefing_id}")
+            assert page.status_code == 200
+            match = re.search(r'name="csrf" value="([a-f0-9]+)"', page.text)
+            assert match is not None
+            csrf = match.group(1)
+            assert client.get("/item/anything").status_code == 404
+            for action in ("approve", "reject", "update-note", "dispatch", "scan", "restore"):
+                assert client.post(f"/{action}/anything", data={"csrf": csrf}).status_code == 404
+            markdown, summary = service.read_artifacts(generated.item)
+            form = {"csrf": csrf, "briefing_markdown": markdown, "discord_summary": summary}
+            assert (
+                client.post(f"/briefing/save/{generated.item.briefing_id}", data=form).status_code
+                == 303
+            )
+            assert (
+                client.post(
+                    f"/briefing/approve/{generated.item.briefing_id}", data=form
+                ).status_code
+                == 303
+            )
+            item = service.store.get(generated.item.briefing_id)
+            assert item is not None and item.status == PublicationStatus.APPROVED
+            assert google.calls == [] and discord.calls == []
+            assert meeting_queue.read_bytes() == before
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join(timeout=2)
+        service.close()
+
+
+def test_briefing_notification_opens_briefing_command_without_meeting_activation(monkeypatch):
+    run = Mock(return_value=Mock(returncode=0))
+    monkeypatch.setattr(
+        "jarvis.meetings.publication.notify.shutil.which", lambda _: "/test/notifier"
+    )
+    monkeypatch.setattr("jarvis.meetings.publication.notify.subprocess.run", run)
+    notifier = LocalNotifier(review_url="http://127.0.0.1:8872/", briefing_port=8872)
+    assert notifier.briefing_pending(1)
+    args = run.call_args.args[0]
+    command = shlex.split(args[args.index("-execute") + 1])
+    assert command[-6:] == ["community", "briefing", "review", "open", "--port", "8872"]
+    assert "meeting" not in command
