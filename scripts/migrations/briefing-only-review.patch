+@pytest.mark.parametrize("stage", ["claim", "google"])
+def test_real_child_crash_does_not_reclaim_or_discard_receipts(setup, stage):
+    clock, store, make, _ = setup
+    script = """
+import os,sys
+from pathlib import Path
+from jarvis.community_briefing.store import BriefingStore
+store=BriefingStore(Path(sys.argv[1]))
+assert store.claim_next() is not None
+if sys.argv[2]=='google':
+    store.record_google('fixture',doc_id='child-doc',doc_url='https://example.invalid/child')
+os._exit(71)
+"""
+    child = subprocess.run(
+        [sys.executable, "-B", "-c", script, str(store.state_root), stage], capture_output=True
+    )
+    assert child.returncode == 71, child.stderr
+    with store.connect() as connection:
+        before = dict(
+            connection.execute(
+                "SELECT * FROM community_briefings WHERE briefing_id='fixture'"
+            ).fetchone()
+        )
+    clock[0] = datetime(2099, 1, 1, tzinfo=UTC)
+    result = make(lambda request: pytest.fail("replayed effect")).worker(max_items=1)
+    assert result.unresolved == 1
+    with store.connect() as connection:
+        after = dict(
+            connection.execute(
+                "SELECT * FROM community_briefings WHERE briefing_id='fixture'"
+            ).fetchone()
+        )
+    assert after == before
+    assert before["lease_until"]
+    assert before["google_doc_id"] == ("child-doc" if stage == "google" else None)
+
