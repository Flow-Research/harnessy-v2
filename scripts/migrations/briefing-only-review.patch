+def test_explicit_429_retains_bounded_retry_and_approval(setup):
+    clock, store, make, _ = setup
+    requests = []
+
+    def transport(request):
+        requests.append(request)
+        return (
+            httpx.Response(429, json={"retry_after": 2.5})
+            if len(requests) == 1
+            else httpx.Response(200, json={"id": "approved-receipt"})
+        )
+
+    service = make(transport)
+    original = store.get("fixture").approved_hash
+    assert service.worker(max_items=1).failed == 1
+    retained = store.get("fixture")
+    assert retained.status.value == "approved"
+    assert retained.approved_hash == original
+    assert retained.google_doc_id == "synthetic-doc"
+    assert service.worker(max_items=1).published == 0
+    assert len(requests) == 1
+    clock[0] += timedelta(seconds=3)
+    assert service.worker(max_items=1).published == 1
+    assert len(requests) == 2
+    assert store.get("fixture").discord_message_id == "approved-receipt"
+
