+def test_failed_delivery_and_notification_do_not_exit_zero(setup, monkeypatch):
+    _, store, make, notifier = setup
+
+    def transport(request):
+        return httpx.Response(403, json={"message": "Synthetic rejection"})
+
+    service = make(transport)
+    cli = importlib.import_module("jarvis.community_briefing.cli")
+    monkeypatch.setattr(cli, "_service", lambda: service)
+    result = CliRunner().invoke(cli.community_cli, ["briefing", "worker", "--json"])
+    assert store.get("fixture").status.value == "blocked"
+    assert notifier.calls == 1
+    assert store.get("fixture").last_notified_at is None
+    assert json.loads(result.output)["failed"] == 1
+    assert result.exit_code != 0, (
+        f"Blocked delivery + failed notification exits success: {result.output}"
+    )
