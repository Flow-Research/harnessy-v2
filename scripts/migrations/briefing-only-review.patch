+def test_uncertain_transport_timeout_does_not_schedule_automatic_retry(setup):
+    clock, store, make, _ = setup
+    posts = []
+
+    def transport(request):
+        posts.append(json.loads(request.content))
+        if len(posts) == 1:
+            raise httpx.ReadTimeout("Synthetic accepted POST lost response", request=request)
+        return httpx.Response(200, json={"id": "retried-receipt"})
+
+    service = make(transport)
+    first = service.worker(max_items=1)
+    assert first.failed == 1
+    clock[0] += timedelta(seconds=61)
+    service.worker(max_items=1)
+    assert len(posts) == 1, f"Uncertain timeout automatically retried: {len(posts)} POSTs"
+
