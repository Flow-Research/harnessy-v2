+def _read_pending() -> dict[str, Any] | None:
+    if PENDING_FILE.is_symlink():
+        raise SuggestionStateError("Pending suggestions must not be a symlink")
+    try:
+        raw = PENDING_FILE.read_text(encoding="utf-8")
+    except FileNotFoundError:
+        return None
+    except UnicodeDecodeError as exc:
+        raise SuggestionStateError(
+            "Damaged pending suggestions; preserve the file and reconcile"
+        ) from exc
+    try:
+        data = json.loads(raw)
+        if not isinstance(data, dict):
+            raise ValueError("Expected an object")
+        if not isinstance(data["space_id"], str) or not data["space_id"].strip():
+            raise ValueError("Missing space")
+        datetime.fromisoformat(data["generated_at"])
+        if "backend" in data and (
+            not isinstance(data["backend"], str) or not data["backend"].strip()
+        ):
+            raise ValueError("Missing generation backend")
+        rows = data["suggestions"]
+        if not isinstance(rows, list):
+            raise ValueError("Expected suggestions")
+        suggestions = [_dict_to_suggestion(row) for row in rows]
+        for key in ("id", "task_id"):
+            values = [getattr(item, key) for item in suggestions]
+            if any(not value.strip() for value in values) or len(values) != len(set(values)):
+                raise ValueError("Empty or duplicate suggestion/task identity")
+        attempts = data.get("attempts", {})
+        if not isinstance(attempts, dict):
+            raise ValueError("Invalid attempts")
+        indexed = {item.id: item for item in suggestions}
+        for identity, attempt in attempts.items():
+            item = indexed[identity]
+            if not isinstance(attempt, dict) or set(attempt) != {"backend", "phase", "started_at"}:
+                raise ValueError("Invalid attempt")
+            if not isinstance(attempt["backend"], str) or not attempt["backend"].strip():
+                raise ValueError("Missing attempt backend")
+            datetime.fromisoformat(attempt["started_at"])
+            if (attempt["phase"], item.status) not in {
+                ("attempting", "pending"),
+                ("applied", "applied"),
+            }:
+                raise ValueError("Inconsistent attempt outcome")
+        return data
+    except (ValueError, KeyError, TypeError, AttributeError) as exc:
+        raise SuggestionStateError(
+            "Damaged pending suggestions; preserve the file and reconcile before continuing"
+        ) from exc
+
+
+@dataclass
+class SuggestionBatch:
+    """One locked pending file; no automatic recovery of uncertain task updates."""
+
+    data: dict[str, Any] | None
+
+    def require_resolved(self) -> None:
+        if self.data and (
+            any(a["phase"] == "attempting" for a in self.data.get("attempts", {}).values())
+            or any(s["status"] == "failed" for s in self.data["suggestions"])
+        ):
+            raise SuggestionStateError(
+                "Uncertain task update; keep pending.json and reconcile the exact backend, "
+                "space, task and dates before retrying or replacing suggestions"
+            )
+
+    def archive(self) -> None:
+        self.require_resolved()
+        if not self.data or not self.data.get("attempts"):
+            return
+        content = PENDING_FILE.read_bytes()
+        directory = PENDING_FILE.parent / "suggestion-history"
+        directory.mkdir(mode=0o700, exist_ok=True)
+        if directory.is_symlink():
+            raise SuggestionStateError("Suggestion history must not be a symlink")
+        directory.chmod(0o700)
+        target = directory / (hashlib.sha256(content).hexdigest() + ".json")
+        try:
+            descriptor = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+        except FileExistsError:
+            if target.is_symlink() or target.read_bytes() != content:
+                raise SuggestionStateError(
+                    "Suggestion history collision; preserve pending.json"
+                ) from None
+            target.chmod(0o600)
+            with target.open("rb") as stream:
+                os.fsync(stream.fileno())
+        else:
+            with os.fdopen(descriptor, "wb") as stream:
+                stream.write(content)
+                stream.flush()
+                os.fsync(stream.fileno())
+        _sync_directory(directory)
+        _sync_directory(directory.parent)
 
+    def save(
+        self, suggestions: list[Suggestion], space_id: str, *, backend: str | None = None
+    ) -> None:
+        self.archive()
+        values = [(s.id, s.task_id) for s in suggestions]
+        if not space_id.strip() or any(not a.strip() or not b.strip() for a, b in values):
+            raise ValueError("Missing suggestion identity or space")
+        if len({a for a, _ in values}) != len(values) or len({b for _, b in values}) != len(values):
+            raise ValueError("Duplicate suggestion or task identity")
+        data = {
+            "generated_at": datetime.now().isoformat(),
+            "space_id": space_id,
+            "suggestions": [_suggestion_to_dict(s) for s in suggestions],
+        }
+        if backend is not None:
+            if not isinstance(backend, str) or not backend.strip():
+                raise ValueError("Missing generation backend")
+            data["backend"] = backend
+        _write_pending(data)
+        self.data = data
 
+    def checkpoint(self, suggestion: Suggestion, backend: str, *, applied: bool = False) -> None:
+        assert self.data is not None
+        if not isinstance(backend, str) or not backend.strip():
+            raise ValueError("Missing backend identity")
+        previous = next(
+            (row for row in self.data["suggestions"] if row["id"] == suggestion.id), None
+        )
+        current = _suggestion_to_dict(suggestion)
+        if previous is None or any(
+            previous[key] != value for key, value in current.items() if key != "status"
+        ):
+            raise ValueError("Suggestion changed before checkpoint")
+        attempts = self.data.setdefault("attempts", {})
+        if applied:
+            if attempts[suggestion.id]["phase"] != "attempting" or suggestion.status != "applied":
+                raise ValueError("Invalid completed attempt")
+            attempts[suggestion.id]["phase"] = "applied"
+        else:
+            self.require_resolved()
+            if suggestion.status != "pending" or suggestion.id in attempts:
+                raise ValueError("Suggestion is not eligible for an attempt")
+            attempts[suggestion.id] = {
+                "backend": backend,
+                "phase": "attempting",
+                "started_at": datetime.now().astimezone().isoformat(),
+            }
+        self.data["suggestions"] = [
+            _suggestion_to_dict(suggestion) if row["id"] == suggestion.id else row
+            for row in self.data["suggestions"]
+        ]
+        _write_pending(self.data)
+
+    def reject(self, suggestion: Suggestion) -> None:
+        assert self.data is not None
+        suggestion.reject()
+        self.data["suggestions"] = [
+            _suggestion_to_dict(suggestion) if row["id"] == suggestion.id else row
+            for row in self.data["suggestions"]
+        ]
+        _write_pending(self.data)
+
+
+@contextmanager
+def suggestion_transaction() -> Iterator[SuggestionBatch]:
+    """Serialize complete suggest/apply commands, including provider work and prompts.
+
+    A busy command fails immediately, rather than waiting to apply an unseen batch.
+    The stable lock file is never unlinked; process death releases only the OS lock.
+    """
+    PENDING_FILE.parent.mkdir(parents=True, exist_ok=True)
+    lock_path = PENDING_FILE.with_suffix(".lock")
+    descriptor = os.open(lock_path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
+    try:
+        os.fchmod(descriptor, 0o600)
+        try:
+            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            raise SuggestionStateError(
+                "Another suggestion/apply command is running; try again later"
+            ) from None
+        yield SuggestionBatch(_read_pending())
+    finally:
+        os.close(descriptor)
+
+
+def save_suggestions(
+    suggestions: list[Suggestion], space_id: str, *, backend: str | None = None
+) -> None:
+    with suggestion_transaction() as batch:
+        batch.save(suggestions, space_id, backend=backend)
+
