+@contextmanager
+def poll_lock(path: Path | None = None):
+    """Serialize local POSIX pollers; never wait or delete another owner's lock."""
+    import fcntl
+
+    state_path = path or default_poll_state_path()
+    state_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    fd = os.open(str(state_path) + ".lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
+    try:
+        if not stat.S_ISREG(os.fstat(fd).st_mode):
+            raise ValueError("Fathom lock is not a regular file")
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError as exc:
+            raise ValueError("Another Fathom poll owns this state") from exc
+        yield
+    finally:
+        os.close(fd)
+
+
+class PollRecording:
+    """One recording's destination receipts inside the existing poll checkpoint."""
+
+    def __init__(self, state, path, key, binding, *, legacy_note=False):
+        self.state, self.path = state, path
+        records = state.setdefault("recordings", {})
+        existing = records.get(key)
+        if existing is None:
+            if legacy_note and "journal" in binding["destinations"]:
+                raise ValueError("Existing note has no journal receipt; reconciliation required")
+            existing = {"binding": binding, "destinations": {}}
+            records[key] = existing
+        if (
+            not isinstance(existing, dict)
+            or existing.get("binding") != binding
+            or not isinstance(existing.get("destinations"), dict)
+        ):
+            raise ValueError("Recording destination binding changed; reconciliation required")
+        self.record = existing
+        assert_poll_ready(state)
+
+    def before(self, destination):
+        previous = self.record["destinations"].get(destination)
+        if previous:
+            return previous["receipt"]
+        self.record["destinations"][destination] = {"state": "intent"}
+        save_poll_state(self.state, self.path)
+        return None
+
+    def complete(self, destination, receipt):
+        _validate_receipt(destination, receipt)
+        # Do not let a failed receipt save be overwritten by the CLI's error save.
+        outcome = {"state": "complete", "receipt": receipt}
+        self.record["destinations"][destination] = outcome
+        try:
+            save_poll_state(self.state, self.path)
+        except BaseException:
+            self.record["destinations"][destination] = {"state": "intent"}
+            raise
+
+
+def assert_poll_ready(state):
+    """Unresolved older recordings must not disappear beyond the overlap window."""
+    records = state.get("recordings", {})
+    if not isinstance(records, dict):
+        raise ValueError("Recording state invalid; reconciliation required")
+    for record in records.values():
+        if (
+            not isinstance(record, dict)
+            or not isinstance(record.get("binding"), dict)
+            or not isinstance(record["binding"].get("destinations"), list)
+            or not isinstance(record.get("destinations"), dict)
+        ):
+            raise ValueError("Recording state invalid; reconciliation required")
+        for destination, outcome in record["destinations"].items():
+            if (
+                destination not in record["binding"]["destinations"]
+                or not isinstance(outcome, dict)
+                or outcome.get("state") not in {"intent", "complete"}
+            ):
+                raise ValueError("Recording receipt invalid; reconciliation required")
+            if outcome["state"] == "intent":
+                raise ValueError("Recording delivery interrupted; reconciliation required")
+            _validate_receipt(destination, outcome.get("receipt"))
+
+
+def _validate_receipt(destination, receipt):
+    if (
+        not isinstance(receipt, list)
+        or any(not isinstance(value, str) or not value.strip() for value in receipt)
+        or (destination in {"journal", "private-context", "wiki"} and len(receipt) != 1)
+    ):
+        raise ValueError("Recording receipt invalid; reconciliation required")
+    if destination != "journal" and any(not Path(value).is_file() for value in receipt):
+        raise ValueError("Local recording receipt missing; reconciliation required")
+
+
+def _regular_state_path(path):
+    try:
+        mode = path.lstat().st_mode
+    except FileNotFoundError:
+        return
+    if not stat.S_ISREG(mode):
+        raise ValueError("Fathom state must be a regular file; reconciliation required")
+
